@page "/login"
@rendermode InteractiveServer

<PageTitle>D'Leon Asociados. Login</PageTitle>

<div class="container">
    <header class="header">
        <a href="/" class="header-brand">
            <span class="header-brand-name">D'LEON</span>
            <span class="header-brand-subtitle">&amp; ASOCIADOS S.R.L</span>
        </a>

        <a href="/" class="header-link">Volver al inicio</a>
    </header>

    <div class="login-section">
        <div class="login-box">
            <h1 class="login-title">
                Inicia sesión para encontrar tu próximo vehículo.
            </h1>

            <div class="login-field">
                <label for="email" class="login-label">Correo electrónico*</label>
                <input id="email" type="email" class="login-input" placeholder="nombre@ejemplo.com" />
            </div>

            <div class="login-field">
                <label for="password" class="login-label">Contraseña*</label>
                <input id="password" type="password" class="login-input" placeholder="*****" />
            </div>

            <a href="/forgot-password" class="login-forgot">¿Olvidaste tu contraseña?</a>

            <p class="login-legal">
                Al continuar, acepto la
                <a href="#">Política de Privacidad</a>
                y los
                <a href="#">Términos de Uso</a>
                de D'Leon Asociados.
            </p>

            <a href="/dashboard" class="submit-btn">Iniciar sesión</a>

            <p class="login-register">
                ¿Aún no tienes cuenta?
                <a href="/register">Regístrate</a>
            </p>
        </div>
    </div>
</div>