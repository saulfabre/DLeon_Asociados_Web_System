@page "/reset-password"
@rendermode InteractiveServer

<PageTitle>D'Leon Asociados. Restablecer contraseña</PageTitle>

<div class="container">
    <header class="header">
        <a href="/" class="header-brand">
            <span class="header-brand-name">D'LEON</span>
            <span class="header-brand-subtitle">&amp; ASOCIADOS S.R.L</span>
        </a>

        <a href="/" class="header-link">Volver al inicio</a>
    </header>

    <div class="reset-section">
        <div class="reset-box">
            <h1 class="reset-title">Restablece tu contraseña</h1>
            <p class="reset-description">
                Crea una nueva contraseña para volver a iniciar sesión en tu cuenta.
            </p>

            <div class="reset-field">
                <label for="new-password" class="reset-label">Nueva contraseña*</label>
                <input id="new-password" type="password" class="reset-input" placeholder="Ingresa tu nueva contraseña" autocomplete="new-password" required />
            </div>

            <div class="reset-field">
                <label for="confirm-password" class="reset-label">Confirma tu nueva contraseña*</label>
                <input id="confirm-password" type="password" class="reset-input" placeholder="Confirma tu nueva contraseña" autocomplete="new-password" required />
            </div>

            <button type="button" class="reset-submit">Restablecer contraseña</button>

            <p class="reset-login">
                <a href="/login">Volver al inicio de sesión</a>
            </p>
        </div>
    </div>
</div>
