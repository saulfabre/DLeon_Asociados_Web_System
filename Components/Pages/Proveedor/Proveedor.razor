@page "/Proveedores"
@rendermode InteractiveServer

<AdminLayout ActivePage="suppliers">
<div class="pagina-proveedores">

    <!-- ENCABEZADO -->
    <header class="header-proveedores">

        <h1>Proveedores</h1>

        <div class="header-derecha">
            <button class="btn-notificacion" type="button" aria-label="Notificaciones">
                <i class="cil-bell" aria-hidden="true"></i>
            </button>

        </div>

    </header>


    <!-- CONTENIDO -->
    <main class="contenido-proveedores">

        <!-- FILTROS -->
        <div class="filtros">

            <input type="text"
                   class="buscar-proveedor"
                   placeholder="Buscar proveedor por nombre o código..." />

            <select>
                <option>Estado</option>
                <option>Activo</option>
                <option>Inactivo</option>
            </select>

            <select>
                <option>Ciudad</option>
                <option>Santo Domingo</option>
                <option>Puerto Plata</option>
                <option>Santiago</option>
                <option>La Romana</option>
            </select>

            <button class="btn-limpiar">
                Limpiar Filtro
            </button>

            <button class="btn-agregar">
                <i class="cil-plus" aria-hidden="true"></i> Agregar Proveedor
            </button>

        </div>


        <!-- TABLA -->
        <table class="tabla-proveedores">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Cédula/RNC</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Ciudad</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

