                            Activo
                        </span>
                    </td>

                    <td>
                        <button class="btn-editar" type="button" aria-label="Editar proveedor"><i class="cil-pencil" aria-hidden="true"></i></button>
                        <button class="btn-eliminar" type="button" aria-label="Eliminar proveedor"><i class="cil-trash" aria-hidden="true"></i></button>
                    </td>
                </tr>


                <tr>
