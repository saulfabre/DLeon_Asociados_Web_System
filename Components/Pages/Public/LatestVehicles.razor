@page "/latest-vehicles"
@rendermode InteractiveServer

<PageTitle>D'Leon Asociados. Últimos Vehículos</PageTitle>

@* Encabezado general *@
<header class="header">
    <a href="/" class="header-brand">
        <span class="header-brand-name">D'LEON</span>
        <span class="header-brand-subtitle">&amp; ASOCIADOS S.R.L</span>
    </a>

    <nav class="header-navigation">
        <a href="/">Inicio</a>
        <a href="/latest-vehicles">Vehículos</a>
        <a href="/Seguros">Seguros</a>
        <a href="/Garantias">Garantías</a>
        <a href="/login">Acceso</a>
    </nav>

    <a href="/login" class="login-btn">Acceso</a>
</header>

@* Hero de vehículos *@
<section class="vehicles-hero">
    <video class="vehicles-hero-video" autoplay muted loop playsinline aria-label="Video de vehículos">
        <source src="/images/imagesSaul/public/hero-video.mp4" type="video/mp4" />
    </video>
    <div class="vehicles-hero-overlay" aria-hidden="true"></div>
    <div class="vehicles-hero-content">
        <p class="vehicles-hero-eyebrow">D'Leon Asociados</p>
        <h1 class="vehicles-hero-title">Muévete a tu manera.</h1>
        <a class="vehicles-hero-link" href="#vehicle-results">
            Explorar vehículos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
        </a>
    </div>
</section>

<section class="vehicles-page">
    <div class="vehicles-layout">
        @* Filtros de búsqueda *@
        <aside class="filter-box">
            <h1 class="filter-title">Buscar por Filtro</h1>

            <div class="filter-controls">
                <div class="filter-field">
                    <label for="vehicle-type">Tipo Vehículo</label>
                    <select id="vehicle-type" class="filter-select" @bind="TipoSeleccionado">
                        <option value="">Todos</option>
                        @foreach (var tipo in Vehiculos.Select(vehiculo => vehiculo.Tipo).Distinct().OrderBy(tipo => tipo))
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="vehicle-brand">Marca</label>
                    <select id="vehicle-brand" class="filter-select" @bind="MarcaSeleccionada">
                        <option value="">Todas</option>
                        @foreach (var marca in Vehiculos.Select(vehiculo => vehiculo.Marca).Distinct().OrderBy(marca => marca))
                        {
                            <option value="@marca">@marca</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="vehicle-model">Modelo</label>
                    <select id="vehicle-model" class="filter-select" @bind="ModeloSeleccionado">
                        <option value="">Todos</option>
                        @foreach (var modelo in Vehiculos.Select(vehiculo => vehiculo.Modelo).Distinct().OrderBy(modelo => modelo))
                        {
                            <option value="@modelo">@modelo</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="vehicle-edition">Edición</label>
                    <select id="vehicle-edition" class="filter-select" @bind="EdicionSeleccionada">
                        <option value="">Todas</option>
                        @foreach (var edicion in Vehiculos.Select(vehiculo => vehiculo.Edicion).Distinct().OrderBy(edicion => edicion))
                        {
                            <option value="@edicion">@edicion</option>
                        }
                    </select>
                </div>

                <div class="filter-year-row">
                    <div class="filter-field">
                        <label for="year-from">Desde (Año)</label>
                        <select id="year-from" class="filter-select" @bind="AnioDesde">
                            <option value="">Todos</option>
                            @foreach (var anio in Vehiculos.Select(vehiculo => vehiculo.Anio).Distinct().OrderBy(anio => anio))
                            {
                                <option value="@anio">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="filter-field">
                        <label for="year-to">Hasta (Año)</label>
                        <select id="year-to" class="filter-select" @bind="AnioHasta">
                            <option value="">Todos</option>
                            @foreach (var anio in Vehiculos.Select(vehiculo => vehiculo.Anio).Distinct().OrderBy(anio => anio))
                            {
                                <option value="@anio">@anio</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="filter-field">
                    <label>Precio</label>
                    <div class="filter-price-row">
                        <input class="filter-input" type="number" min="0" max="1500000" step="1000" placeholder="Mínimo" aria-label="Precio mínimo" @bind="PrecioMinimo" />
                        <input class="filter-input" type="number" min="0" max="1500000" step="1000" placeholder="Máximo" aria-label="Precio máximo" @bind="PrecioMaximo" />
                    </div>
                </div>

                <div class="filter-actions">
                    <button class="filter-btn" type="button" @onclick="Buscar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" />
                            <path d="m20 20-4-4" />
                        </svg>
                        Buscar
                    </button>
                    <button class="filter-clear" type="button" @onclick="LimpiarFiltros">Limpiar filtros</button>
                </div>
            </div>
        </aside>

        @* Resultados de vehículos *@
        <div class="vehicle-results" id="vehicle-results">
            <div class="results-header">
                @if (VehiculosFiltrados.Count > 0)
                {
                    <p>Mostrando 1-@VehiculosFiltrados.Count de @VehiculosFiltrados.Count resultados</p>
                }
                else
                {
                    <p>Mostrando 0 resultados</p>
                }
            </div>

            @if (VehiculosFiltrados.Count > 0)
            {
                <div class="vehicle-grid">
                    @foreach (var vehiculo in VehiculosFiltrados)
                    {
                        <article class="vehicle-card">
                            <div class="vehicle-image-container">
                                <img class="vehicle-image" src="@vehiculo.Imagen" alt="@vehiculo.Nombre" />
                                <button class="vehicle-arrow vehicle-arrow-left" type="button" aria-label="Imagen anterior">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m15 18-6-6 6-6" />
                                    </svg>
                                </button>
                                <button class="vehicle-arrow vehicle-arrow-right" type="button" aria-label="Imagen siguiente">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m9 18 6-6-6-6" />
                                    </svg>
                                </button>
                                <span class="vehicle-tag">@vehiculo.Tipo</span>
                                <span class="vehicle-tag vehicle-year">@vehiculo.Anio</span>
                            </div>

                            <div class="vehicle-info">
                                <h2 class="vehicle-name">@vehiculo.Nombre</h2>
                                <div class="vehicle-specs">
                                    <div class="vehicle-spec">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 21V4a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v17" />
                                            <path d="M5 10h11M8 6h5M16 7h2l3 3v7a2 2 0 0 1-4 0v-3h-1M3 21h15" />
                                        </svg>
                                        <span class="vehicle-spec-label">Combustible</span>
                                        <span class="vehicle-spec-value">@vehiculo.Combustible</span>
                                    </div>
                                    <div class="vehicle-spec">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M3 14a9 9 0 0 1 18 0M12 14l4-5M5 18h14" />
                                            <circle cx="12" cy="14" r="1" />
                                        </svg>
                                        <span class="vehicle-spec-label">Millaje</span>
                                        <span class="vehicle-spec-value">@vehiculo.Millaje</span>
                                    </div>
                                    <div class="vehicle-spec">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 4v16M19 4v16M5 8h14M5 16h14" />
                                            <circle cx="5" cy="8" r="2" />
                                            <circle cx="19" cy="8" r="2" />
                                            <circle cx="5" cy="16" r="2" />
                                            <circle cx="19" cy="16" r="2" />
                                        </svg>
                                        <span class="vehicle-spec-label">Transmisión</span>
                                        <span class="vehicle-spec-value">@vehiculo.Transmision</span>
                                    </div>
                                </div>

                                <footer class="vehicle-footer">
                                    <p class="vehicle-price">RD$ @vehiculo.Precio.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</p>
                                    <a class="vehicle-link" href="/vehiculos">
                                        Ver Detalles
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M7 17 17 7M8 7h9v9" />
                                        </svg>
                                    </a>
                                    <button class="vehicle-favorite" type="button" aria-label="Agregar a favoritos">
                                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                                        </svg>
                                    </button>
                                </footer>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="no-results">No se encontraron vehículos</p>
            }
        </div>
    </div>
</section>

@code {
    private List<Vehiculo> Vehiculos = new()
    {
        new Vehiculo { Tipo = "Jeepeta", Marca = "BMW", Modelo = "X7", Edicion = "xDrive40i", Anio = 2022, Nombre = "2022 BMW X7 xDrive40i", Precio = 5200000, Combustible = "Gasolina", Millaje = "28,500 Km", Transmision = "Automático", Imagen = "/images/imagesSaul/public/bmw-x7.jpg.jpeg" },
        new Vehiculo { Tipo = "Sedán", Marca = "Kia", Modelo = "K5", Edicion = "GT-Line", Anio = 2022, Nombre = "2022 Kia K5 GT-Line", Precio = 1450000, Combustible = "Gasolina", Millaje = "24,000 Km", Transmision = "Automático", Imagen = "/images/imagesSaul/public/kia-k5.jpeg" },
        new Vehiculo { Tipo = "Jeepeta", Marca = "Toyota", Modelo = "4Runner", Edicion = "SR5", Anio = 2022, Nombre = "2022 Toyota 4Runner SR5", Precio = 3850000, Combustible = "Gasolina", Millaje = "32,000 Km", Transmision = "Automático", Imagen = "/images/imagesSaul/public/toyota-4runner.jpeg" },
        new Vehiculo { Tipo = "Sedán", Marca = "Toyota", Modelo = "Corolla", Edicion = "LE", Anio = 2019, Nombre = "2019 Toyota Corolla LE", Precio = 890000, Combustible = "Gasolina", Millaje = "56,800 Km", Transmision = "Automático", Imagen = "/images/imagesSaul/public/toyota-corolla.webp" },
        new Vehiculo { Tipo = "Camioneta", Marca = "Toyota", Modelo = "Hilux", Edicion = "SR", Anio = 2022, Nombre = "2022 Toyota Hilux SR", Precio = 1490000, Combustible = "Diésel", Millaje = "18,600 Km", Transmision = "Manual", Imagen = "/images/imagesSaul/public/toyota-hilux.jpg" },
        new Vehiculo { Tipo = "Camioneta", Marca = "Toyota", Modelo = "Tacoma", Edicion = "SR5", Anio = 2021, Nombre = "2021 Toyota Tacoma SR5", Precio = 1500000, Combustible = "Gasolina", Millaje = "35,000 Km", Transmision = "Automático", Imagen = "/images/imagesSaul/public/toyota-tacoma.webp" }
    };

    private List<Vehiculo> VehiculosFiltrados = new();
    private string TipoSeleccionado { get; set; } = string.Empty;
    private string MarcaSeleccionada { get; set; } = string.Empty;
    private string ModeloSeleccionado { get; set; } = string.Empty;
    private string EdicionSeleccionada { get; set; } = string.Empty;
    private int? AnioDesde { get; set; }
    private int? AnioHasta { get; set; }
    private decimal? PrecioMinimo { get; set; }
    private decimal? PrecioMaximo { get; set; }

    protected override void OnInitialized()
    {
        VehiculosFiltrados = new(Vehiculos);
    }

    private void Buscar()
    {
        VehiculosFiltrados = Vehiculos
            .Where(vehiculo =>
                (string.IsNullOrEmpty(TipoSeleccionado) || vehiculo.Tipo == TipoSeleccionado) &&
                (string.IsNullOrEmpty(MarcaSeleccionada) || vehiculo.Marca == MarcaSeleccionada) &&
                (string.IsNullOrEmpty(ModeloSeleccionado) || vehiculo.Modelo == ModeloSeleccionado) &&
                (string.IsNullOrEmpty(EdicionSeleccionada) || vehiculo.Edicion == EdicionSeleccionada) &&
                (!AnioDesde.HasValue || vehiculo.Anio >= AnioDesde.Value) &&
                (!AnioHasta.HasValue || vehiculo.Anio <= AnioHasta.Value) &&
                (!PrecioMinimo.HasValue || vehiculo.Precio >= PrecioMinimo.Value) &&
                (!PrecioMaximo.HasValue || vehiculo.Precio <= PrecioMaximo.Value))
            .ToList();
    }

    private void LimpiarFiltros()
    {
        TipoSeleccionado = string.Empty;
        MarcaSeleccionada = string.Empty;
        ModeloSeleccionado = string.Empty;
        EdicionSeleccionada = string.Empty;
        AnioDesde = null;
        AnioHasta = null;
        PrecioMinimo = null;
        PrecioMaximo = null;
        VehiculosFiltrados = new(Vehiculos);
    }

    private class Vehiculo
    {
        public string Tipo { get; set; } = string.Empty;
        public string Marca { get; set; } = string.Empty;
        public string Modelo { get; set; } = string.Empty;
        public string Edicion { get; set; } = string.Empty;
        public int Anio { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public string Combustible { get; set; } = string.Empty;
        public string Millaje { get; set; } = string.Empty;
        public string Transmision { get; set; } = string.Empty;
        public string Imagen { get; set; } = string.Empty;
    }
}

