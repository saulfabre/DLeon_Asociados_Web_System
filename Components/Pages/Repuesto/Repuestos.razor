@page "/Repuestos"
@using DLeon_Asociados_Web.Models
@using DLeon_Asociados_Web.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@using RepuestoModel = DLeon_Asociados_Web.Models.Repuestos
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject RepuestosServices RepuestosServices

<AdminLayout ActivePage="parts">
    <div class="pagina-repuestos">
        <header class="header-repuestos admin-page-header">
            <h1>Catálogo de Repuestos</h1>
        </header>

        <main class="contenido-repuestos">
            <div class="contenido-card">
            <div class="barra-herramientas">
                <label class="busqueda-repuestos">
                    <i class="cil-search" aria-hidden="true"></i>
                    <input type="search" placeholder="Buscar repuesto por nombre o código..."
                           @bind="TextoBusqueda" @bind:event="oninput" @bind:after="ReiniciarPaginacion" />
                </label>

                <div class="acciones">
                    <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarFiltros">
                        Limpiar filtros
                    </button>
                    <button class="btn btn-primary btn-generar" type="button" @onclick="ImprimirReporte">
                        <i class="cil-print" aria-hidden="true"></i> Generar reporte
                    </button>
                    <a class="btn btn-outline-secondary btn-importar" href="/Repuestos/Importar">
                        <i class="cil-cloud-download" aria-hidden="true"></i> Importar CSV
                    </a>
                    <button class="btn btn-primary btn-agregar" type="button" @onclick="AbrirNuevo">
                        <i class="cil-plus" aria-hidden="true"></i> Agregar Repuesto
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorCarga))
            {
                <div class="alert alert-danger" role="alert">@ErrorCarga</div>
            }

            @if (Cargando)
            {
                <div class="estado-vacio" role="status">Cargando repuestos...</div>
            }
            else if (RepuestosFiltrados.Count == 0)
            {
                <div class="estado-vacio">
                    @(RegistrosRepuestos.Count == 0
                        ? "No hay repuestos registrados."
                        : "No hay repuestos que coincidan con la búsqueda.")
                </div>
            }
            else
            {
                <div class="tabla-responsive">
                    <QuickGrid @key="TextoBusqueda" TGridItem="RepuestoModel"
                               Items="@RepuestosFiltrados.AsQueryable()" Pagination="@Paginacion"
                               Class="table table-bordered table-hover align-middle tabla-repuestos">
                        <PropertyColumn Property="repuesto => repuesto.Nombre" Title="Nombre Pieza" Sortable="true" />
                        <PropertyColumn Property="repuesto => repuesto.Marca" Title="Marca" Sortable="true" />
                        <PropertyColumn Property="repuesto => repuesto.Tipo" Title="Tipo" Sortable="true" />
                        <PropertyColumn Property="repuesto => repuesto.Tamano" Title="Tamaño" />
                        <PropertyColumn Property="repuesto => repuesto.Disponibles" Title="Disponibles" Sortable="true" />
                        <TemplateColumn Title="Precio Unitario" Sortable="true" SortBy="OrdenPrecio" Context="repuesto">
                            <span class="precio">
                                $@repuesto.PrecioUnitario.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                            </span>
                        </TemplateColumn>
                        <PropertyColumn Property="repuesto => repuesto.Proveedor" Title="Proveedor" Sortable="true" />
                        <TemplateColumn Title="Acciones" Class="no-print" Context="repuesto">
                            <div class="acciones-registro">
                                <button class="btn btn-sm btn-outline-primary" type="button"
                                        title="Editar repuesto" aria-label="Editar repuesto"
                                        @onclick="() => AbrirEdicion(repuesto)">
                                    <i class="cil-pencil" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" type="button"
                                        title="Eliminar repuesto" aria-label="Eliminar repuesto"
                                        @onclick="() => Eliminar(repuesto)">
                                    <i class="cil-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@Paginacion" />
                </div>
            }
            </div>
        </main>
    </div>
    <RepuestoFormModal Visible="MostrarModal"
                        VisibleChanged="CambiarVisibilidadModal"
                        Repuesto="RepuestoSeleccionado"
                        OnSaved="RecargarRepuestos" />
</AdminLayout>

@code {
    private readonly PaginationState Paginacion = new() { ItemsPerPage = 10 };
    private List<RepuestoModel> RegistrosRepuestos = new();
    private string TextoBusqueda = string.Empty;
    private string? ErrorCarga;
    private bool Cargando = true;
    private bool MostrarModal;
    private RepuestoModel? RepuestoSeleccionado;

    private static GridSort<RepuestoModel> OrdenPrecio { get; } =
        GridSort<RepuestoModel>.ByAscending(repuesto => repuesto.PrecioUnitario);

    private List<RepuestoModel> RepuestosFiltrados => RegistrosRepuestos
        .Where(repuesto => string.IsNullOrWhiteSpace(TextoBusqueda) ||
            repuesto.Nombre.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            repuesto.Marca.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            repuesto.Tipo.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (repuesto.Tamano?.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
            (repuesto.Proveedor?.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await RecargarRepuestos();
        Cargando = false;
    }

    private async Task RecargarRepuestos()
    {
        try
        {
            ErrorCarga = null;
            RegistrosRepuestos = await RepuestosServices.ObtenerTodos();
            await ReiniciarPaginacion();
        }
        catch (Exception exception)
        {
            ErrorCarga = $"No fue posible cargar los repuestos. {exception.Message}";
        }
    }

    private void AbrirNuevo()
    {
        RepuestoSeleccionado = null;
        MostrarModal = true;
    }

    private void AbrirEdicion(RepuestoModel repuesto)
    {
        RepuestoSeleccionado = repuesto;
        MostrarModal = true;
    }

    private Task CambiarVisibilidadModal(bool visible)
    {
        MostrarModal = visible;
        return Task.CompletedTask;
    }

    private async Task Eliminar(RepuestoModel repuesto)
    {
        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Deseas eliminar el repuesto {repuesto.Nombre}?");

        if (!confirmar)
        {
            return;
        }

        try
        {
            ErrorCarga = null;
            if (!await RepuestosServices.Eliminar(repuesto.Id))
            {
                ErrorCarga = "El repuesto ya no existe o fue eliminado por otro usuario.";
                return;
            }

            await RecargarRepuestos();
        }
        catch (Exception exception)
        {
            ErrorCarga = $"No fue posible eliminar el repuesto. {exception.Message}";
        }
    }

    private async Task LimpiarFiltros()
    {
        TextoBusqueda = string.Empty;
        await ReiniciarPaginacion();
    }

    private Task ReiniciarPaginacion() => Paginacion.SetCurrentPageIndexAsync(0);

    private Task ImprimirReporte() => JS.InvokeVoidAsync("window.print").AsTask();
}
