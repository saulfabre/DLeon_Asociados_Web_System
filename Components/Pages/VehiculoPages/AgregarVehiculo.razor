@page "/vehiculo/agregar"
@rendermode InteractiveServer

<PageTitle>Agregar Vehículo | D'Leon Asociados</PageTitle>

<AdminLayout ActivePage="vehicles">
<div class="pagina-agregar">

    <!-- ==============================
         CONTENIDO PRINCIPAL
         ============================== -->
    <main class="contenido">

        <!-- Barra superior -->
        <header class="barra-superior">

            <div class="titulo">
                Agregar Vehículo
            </div>

            <div class="barra-derecha">
                <button class="notificacion" type="button" aria-label="Notificaciones">
                    <i class="cil-bell" aria-hidden="true"></i>
                </button>

            </div>

        </header>


        <!-- ==============================
             CONTENIDO DEL FORMULARIO
             ============================== -->
        <div class="contenido-principal">

            <!-- Encabezado -->
            <div class="encabezado-pagina">

                <div>
                    <h1>Agregar Vehículo</h1>

                    <p>
                        Registra un nuevo vehículo en el inventario.
                    </p>
                </div>

                <a href="/vehiculos" class="btn-volver">
                    <i class="cil-arrow-left" aria-hidden="true"></i> Volver al inventario
                </a>

            </div>


            <!-- ==============================
                 FORMULARIO
                 ============================== -->
            <div class="formulario-card">

                <div class="formulario-header">

                    <h2>Información del vehículo</h2>

                    <p>
                        Completa todos los datos necesarios del vehículo.
                    </p>

                </div>


                <div class="formulario-body">

                    <!-- ==============================
                         INFORMACIÓN BÁSICA
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Información básica</h3>

                        <div class="form-grid">

                            <!-- Marca -->
                            <div class="campo">

                                <label for="marca">
                                    Marca
                                    <span>*</span>
                                </label>

                                <select id="marca"
                                        @bind="Marca">

                                    <option value="">
                                        Seleccionar marca
                                    </option>

                                    <option value="Toyota">
                                        Toyota
                                    </option>

                                    <option value="BMW">
                                        BMW
                                    </option>

                                    <option value="Kia">
                                        Kia
                                    </option>

                                    <option value="Honda">
                                        Honda
                                    </option>

                                    <option value="Hyundai">
                                        Hyundai
                                    </option>

                                    <option value="Mercedes-Benz">
                                        Mercedes-Benz
                                    </option>

                                    <option value="Ford">
                                        Ford
                                    </option>

                                </select>

                            </div>


                            <!-- Modelo -->
                            <div class="campo">

                                <label for="modelo">
                                    Modelo
                                    <span>*</span>
                                </label>

                                <input id="modelo"
                                       type="text"
                                       @bind="Modelo"
                                       placeholder="Ej. Hilux" />

                            </div>


                            <!-- Año -->
                            <div class="campo">

                                <label for="anio">
                                    Año
                                    <span>*</span>
                                </label>

                                <input id="anio"
                                       type="number"
                                       @bind="Anio"
                                       placeholder="Ej. 2025" />

                            </div>


                            <!-- Precio -->
                            <div class="campo">

                                <label for="precio">
                                    Precio
                                    <span>*</span>
                                </label>

                                <div class="input-precio">

                                    <span>$</span>

                                    <input id="precio"
                                           type="number"
                                           @bind="Precio"
                                           placeholder="0.00" />

                                </div>

                            </div>


                            <!-- Estado -->
                            <div class="campo">

                                <label for="estado">
                                    Estado
                                    <span>*</span>
                                </label>

                                <select id="estado"
                                        @bind="Estado">

                                    <option value="">
                                        Seleccionar estado
                                    </option>

                                    <option value="Disponible">
                                        Disponible
                                    </option>

                                    <option value="Reservado">
                                        Reservado
                                    </option>

                                    <option value="Vendido">
                                        Vendido
                                    </option>

                                </select>

                            </div>


                            <!-- Tipo -->
                            <div class="campo">

                                <label for="tipo">
                                    Tipo de vehículo
                                    <span>*</span>
                                </label>

                                <select id="tipo"
                                        @bind="Tipo">

                                    <option value="">
                                        Seleccionar tipo
                                    </option>

                                    <option value="Sedán">
                                        Sedán
                                    </option>

                                    <option value="SUV">
                                        SUV
                                    </option>

                                    <option value="Pick-up">
                                        Pick-up
                                    </option>

                                    <option value="Coupé">
                                        Coupé
                                    </option>

                                    <option value="Camioneta">
                                        Camioneta
                                    </option>

                                    <option value="Van">
                                        Van
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- ==============================
                         INFORMACIÓN ADICIONAL
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Información adicional</h3>

                        <div class="form-grid">

                            <!-- Color -->
                            <div class="campo">

                                <label for="color">
                                    Color
                                </label>

                                <input id="color"
                                       type="text"
                                       @bind="Color"
                                       placeholder="Ej. Negro" />

                            </div>


                            <!-- Combustible -->
                            <div class="campo">

                                <label for="combustible">
                                    Combustible
                                </label>

                                <select id="combustible"
                                        @bind="Combustible">

                                    <option value="">
                                        Seleccionar combustible
                                    </option>

                                    <option value="Gasolina">
                                        Gasolina
                                    </option>

                                    <option value="Diésel">
                                        Diésel
                                    </option>

                                    <option value="Híbrido">
                                        Híbrido
                                    </option>

                                    <option value="Eléctrico">
                                        Eléctrico
                                    </option>

                                </select>

                            </div>


                            <!-- Transmisión -->
                            <div class="campo">

                                <label for="transmision">
                                    Tipo de transmisión
                                </label>

                                <select id="transmision"
                                        @bind="Transmision">

                                    <option value="">
                                        Seleccionar transmisión
                                    </option>

                                    <option value="Automática">
                                        Automática
                                    </option>

                                    <option value="Manual">
                                        Manual
                                    </option>

                                </select>

                            </div>


                            <!-- Kilometraje -->
                            <div class="campo">

                                <label for="kilometraje">
                                    Kilometraje (km)
                                </label>

                                <input id="kilometraje"
                                       type="number"
                                       @bind="Kilometraje"
                                       placeholder="Ej. 25000" />

                            </div>

                        </div>

                    </div>


                    <!-- ==============================
                         DESCRIPCIÓN
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Descripción</h3>

                        <div class="campo campo-completo">

                            <label for="descripcion">
                                Descripción del vehículo
                            </label>

                            <textarea id="descripcion"
                                      @bind="Descripcion"
                                      placeholder="Escribe una descripción del vehículo..."
                                      rows="5">
                            </textarea>

                        </div>

                    </div>


                    <!-- ==============================
                         IMAGEN
                         ============================== -->
                    <div class="seccion-formulario">

                        <h3>Imagen del vehículo</h3>

                        <div class="subir-imagen">

                            <div class="icono-imagen">
                                <i class="cil-image" aria-hidden="true"></i>
                            </div>

                            <h4>Agregar imagen</h4>

                            <p>
                                Selecciona una imagen del vehículo
                            </p>

                            <label class="btn-subir">

                                Seleccionar imagen

                                <InputFile OnChange="SeleccionarImagen" />

                            </label>

                            @if (!string.IsNullOrEmpty(NombreImagen))
                            {
                                <div class="imagen-seleccionada">
                                    <i class="cil-check-circle" aria-hidden="true"></i> @NombreImagen
                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- ==============================
                     BOTONES
                     ============================== -->
                <div class="formulario-footer">

                    <a href="/vehiculos"
                       class="btn-cancelar">

                        Cancelar

                    </a>

                    <button class="btn-guardar"
                            @onclick="GuardarVehiculo">

                        <i class="cil-check-circle" aria-hidden="true"></i> Guardar vehículo

                    </button>

                </div>

            </div>

        </div>

    </main>

</div>

</AdminLayout>


@code {

    private string Marca = "";
    private string Modelo = "";
    private int? Anio;
    private decimal? Precio;
    private string Estado = "";
    private string Tipo = "";

    private string Color = "";
    private string Combustible = "";
    private string Transmision = "";
    private int? Kilometraje;

    private string Descripcion = "";

    private string NombreImagen = "";


    private void SeleccionarImagen(
        Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        NombreImagen = e.File.Name;
    }


    private void GuardarVehiculo()
    {
        // Aquí posteriormente conectaremos
        // el formulario con la base de datos.

        Console.WriteLine("Vehículo guardado.");
    }

}